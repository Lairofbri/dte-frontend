{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dte-frontend",
  "compatibility_date": "2026-05-28",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "VITE_API_URL": "http://localhost:4000"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
